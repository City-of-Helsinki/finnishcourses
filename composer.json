{
    "name": "drupal-composer/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "bootstrap-datepicker/bootstrap-datepicker",
                "version": "1.9.0",
                "type": "drupal-library",
                "dist": {
                  "url": "https://github.com/uxsolutions/bootstrap-datepicker/archive/master.zip",
                  "type": "zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "datetimepicker/datetimepicker",
                "version": "2.5.20",
                "type": "drupal-library",
                "dist": {
                  "url": "https://github.com/xdan/datetimepicker/archive/2.5.20.zip",
                  "type": "zip"
                }
            }
		},
		{
			"type": "package",
			"package": {
				"name": "furf/jquery-ui-touch-punch",
				"version": "dev-master",
				"type": "drupal-library",
				"dist": {
					"url": "https://github.com/furf/jquery-ui-touch-punch/archive/refs/heads/master.zip",
					"type": "zip"
				}
			}	
        }
    ],
    "require": {
        "php": ">=5.6",
        "bootstrap-datepicker/bootstrap-datepicker": "^1.9",
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.6.5",
        "datetimepicker/datetimepicker": "^2.5",
        "drupal/admin_toolbar": "3.5.1",
        "drupal/allowed_formats": "^3.0",
        "drupal/autologout": "2.0.0",
        "drupal/better_exposed_filters": "7.0.2",
        "drupal/block_visibility_groups": "2.0.3",
        "drupal/bootstrap_barrio": "5.1.12",
        "drupal/bootstrap_datepicker": "^2.0",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_split": "2.0.1",
        "drupal/core": "11.0.7",
        "drupal/ctools": "4.1.0",
        "drupal/entity_browser": "2.12",
        "drupal/field_group": "4.0.0-alpha1",
        "drupal/file_mdm": "3.1.0",
        "drupal/filelog": "^3.0",
        "drupal/flood_control": "3.0.0",
        "drupal/geolocation": "4.0.0-alpha7",
        "drupal/google_tag": "2.0.6",
        "drupal/honeypot": "^2.2.0",
        "drupal/image_effects": "4.0.0-rc3",
        "drupal/jquery_ui_touch_punch": "^1.0",
        "drupal/js_cookie": "^1.0",
        "drupal/linkit": "7.0.0-alpha2",
        "drupal/maxlength": "^3.1.0",
        "drupal/menu_admin_per_menu": "^1.0",
        "drupal/menu_block": "^1.5",
        "drupal/menu_trail_by_path": "2.1.0",
        "drupal/metatag": "^2.1.0",
        "drupal/office_hours": "1.x-dev@dev",
        "drupal/pathauto": "1.13",
        "drupal/quick_node_clone": "1.19",
        "drupal/recaptcha": "^3.1",
        "drupal/recaptcha_v3": "^2.0.3",
        "drupal/redirect": "^1.3",
        "drupal/redirect_after_login": "^3.0",
        "drupal/redis": "^1.1",
        "drupal/restui": "^1.17",
        "drupal/role_delegation": "^1.0@alpha",
        "drupal/scheduler": "^2.1.0",
        "drupal/search_api": "1.35",
        "drupal/select_or_other": "4.x-dev@dev",
        "drupal/sendgrid_integration": "2.3",
        "drupal/simple_popup_blocks": "^3.4",
        "drupal/simple_sitemap": "4.2.1",
        "drupal/single_datetime": "2.0.0-beta2",
        "drupal/spamspan": "3.2.0",
        "drupal/time_range": "9.0.3",
        "drupal/token": "^1.5",
        "drupal/tvi": "2.0.0",
        "drupal/twig_debugger": "^1.1",
        "drupal/ultimate_cron": "^2.0@alpha",
        "drupal/view_unpublished": "^1.3",
        "drupal/webform": "6.3.x-dev@dev",
        "drush/drush": "^13.0",
        "furf/jquery-ui-touch-punch": "dev-master",
        "mglaman/composer-drupal-lenient": "^1.0",
        "platformsh/config-reader": "^2.2",
        "vlucas/phpdotenv": "^2.4",
        "w8tcha/ckeditor-wordcount-plugin": "^1.17",
        "webflo/drupal-finder": "^1.0.0",
        "webmozart/path-util": "^2.3",
        "wikimedia/composer-merge-plugin": "^2.0",
        "zaporylie/composer-drupal-optimizations": "^1.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/console-extend-plugin": true,
            "zodiacmedia/drupal-libraries-installer": true,
            "cweagans/composer-patches": true,
            "wikimedia/composer-merge-plugin": true,
            "zaporylie/composer-drupal-optimizations": true,
            "mglaman/composer-drupal-lenient": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": ["load.environment.php"]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/{$name}": ["type:drupal-drush"]
        },
        "patches": {
            "drupal/core": {
                "Grouped exposed filters do not work like they should": "https://www.drupal.org/files/issues/1810148-58.patch",
				"If you dont want to translate your URL alias the original URL alias wont work with your translations": "https://www.drupal.org/files/issues/2024-06-26/2689459_d10.3.0.patch",
				"Entity view/form mode formatter/widget settings have no translation UI Action patch": "https://www.drupal.org/files/issues/2020-12-04/2546212-168-actions.patch",
				"Entity view/form mode formatter/widget settings have no translation UI": "https://www.drupal.org/files/issues/2020-12-04/2546212-168.patch",
				"PHP Notice: Undefined index: type in claro_preprocess_input()": "https://www.drupal.org/files/issues/2020-06-02/preprocess-input-notice-3144876-6.patch",
				"Make exposed filter values available as tokens for text areas":"https://www.drupal.org/files/issues/2022-10-30/2761273-50.patch",
				"Warning: Undefined array key value in Drupal":"https://www.drupal.org/files/issues/2024-01-31/3418238-2.patch"
            },
			"drupal/redirect_after_login": {
				"Headers have already been sent after upgrade to Drupal 9.2 (can't login)": "https://www.drupal.org/files/issues/2021-06-20/3214949.patch"
			},
			"drupal/search_api": {
				"Search Results - undefined array key #conjunction in prepareKeys()": "patches/contrib/search_api/0001-fix.patch"
			},
			"drupal/inline_entity_form": {
				"Translate entity type label": "https://www.drupal.org/files/issues/2021-01-28/inline_entity_form-translate-entity-type-label-3195264-2-D8.patch"
			},
			"drupal/shortcutperrole": {
				"Automated Drupal 10 patch": "https://www.drupal.org/files/issues/2022-06-16/shortcutperrole.2.0.x-dev.rector.patch"
			},
			"drupal/autologout": {
				"Warning: Undefined array key 1": "https://www.drupal.org/files/issues/2024-06-18/autologout_3372010-29.patch"
			},
			"drupal/redirect_after_login": {
				"Drupal 11 compatibility": "https://www.drupal.org/files/issues/2024-07-22/redirect_after_login-3462725.patch"
			},
			"drupal/filelog": {
				"Drupal 11 compatibility": "https://www.drupal.org/files/issues/2024-07-28/filelog.3.0.x-dev.rector.patch"
			},
			"drupal/conditional_fields": {
				"Automated Drupal 11 compatibility fixes for conditional_fields": "https://www.drupal.org/files/issues/2024-08-26/drupal-11-compatibility-3428532-12.patch"
			},
			"drupal/select_or_other": {
				"Automated Drupal 11 compatibility fixes for select_or_other": "https://www.drupal.org/files/issues/2024-05-30/select_or_other.4.x-dev.rector.patch"
			},
			"drupal/bootstrap_datepicker": {
				"Automated Drupal 11 compatibility fixes for bootstrap_datepicker": "https://www.drupal.org/files/issues/2024-03-16/bootstrap_datepicker.2.0.0.rector.patch"
			}

        },
        "drupal-scaffold": {
            "initial": {
                ".editorconfig": "../.editorconfig",
                ".gitattributes": "../.gitattributes"
            }
        },
		"merge-plugin": {
            "include": [
                "web/modules/contrib/ckwordcount/composer.libraries.json"
            ]
        },
        "drupal-lenient": {
            "allowed-list": ["drupal/bootstrap_datepicker", "drupal/conditional_fields", "drupal/filelog", "drupal/redirect_after_login", "drupal/force_password_change", "drupal/select_or_other"]
        }
    }
}
